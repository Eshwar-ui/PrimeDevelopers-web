# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
#
# Deny by default: every .env file is ignored, including any new
# .env.<something> nobody has thought of yet, so a file holding real
# credentials cannot be committed by forgetting to add a line here. Files that
# genuinely belong in the repo are re-included one by one below.
.env
.env.*

# The two web build configs. Committed on purpose: a VITE_ variable is inlined
# into the bundle and readable by anyone who opens the JavaScript, so there is
# nothing to protect — and the frontend is built from a developer's machine
# rather than by CI, so the deployed bundle must not depend on whose local file
# was current. See apps/web/.env.example.
!apps/web/.env.development
!apps/web/.env.production

# Templates. No real values, by definition.
!.env.example

# The API's secrets stay out: apps/api/.env is local-only and production lives
# in the Render dashboard (render.yaml, `sync: false`). Both are covered by the
# deny-by-default above — do not add a negation for them.

# Supabase local dev
supabase/.temp
supabase/.branches

# Generated 3D test fixture — rebuild with scripts/make-test-model.mjs.
# Kept out of the repo so it never ships to the live site.
test-model.glb

# Editor/tool backups of env files — these carry real secrets, and the pattern
# has to survive the negations above (apps/web/.env.production.bak would
# otherwise slip through .env.* → !apps/web/.env.production is not a match, but
# a tool writing "…production.bak" next to it is worth the belt and braces).
*.env.bak
*.env.*.bak

.impeccable
