# Local development only. Gitignored.
# Production values live in the Render dashboard — see .env.example.
#
# Currently pointed at a local Postgres 14 scratch database, created with:
#   createdb prime_developers_cms_scratch
#   pnpm --filter @prime-developers/api exec prisma db push
# It has the CMS tables but no data. Swap to the Supabase local stack
# (postgresql://postgres:postgres@127.0.0.1:55322/postgres) once Docker is
# running and `supabase start` has been run — that one has seed data and
# storage, which this scratch DB does not.

# ── Supabase cloud (project knghxhtfkbswzhphhigy) ────────────────────────
# THIS IS PRODUCTION. Anything written here — seeding, admin edits, deletes —
# lands on the data the live site serves.
#
# Paste the two connection strings from:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
#   • DATABASE_URL — "Transaction pooler" (port 6543); keep the ?pgbouncer=… suffix
#   • DIRECT_URL   — "Session pooler"     (port 5432); Prisma migrations use this
# Direct connection (5432). This host is IPv6-only — it has no A record — so a
# network without IPv6 must use the pooler host from the dashboard instead.
DATABASE_URL="postgresql://postgres:Prime2026prime@db.knghxhtfkbswzhphhigy.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:Prime2026prime@db.knghxhtfkbswzhphhigy.supabase.co:5432/postgres"

# Storage, for admin image and .glb uploads.
# Key from: Project Settings → API → Project API keys → service_role (secret)
SUPABASE_URL="https://knghxhtfkbswzhphhigy.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtuZ2h4aHRma2Jzd3pocGhoaWd5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTMzNjAzNSwiZXhwIjoyMTAwOTEyMDM1fQ.TNM3ENL1qMa6o6Q5pNdS8JNNlu_2yK-XshrHLJEM13I"

# ── Local scratch Postgres (previous target) ─────────────────────────────
# Uncomment these two and comment out the Supabase pair above to switch back.
# DATABASE_URL="postgresql://kalyan@127.0.0.1:5432/prime_developers_cms_scratch"
# DIRECT_URL="postgresql://kalyan@127.0.0.1:5432/prime_developers_cms_scratch"

NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:5173
# Vite's fallback ports are listed too: if 5173 is taken it silently starts on
# the next one, and an unlisted origin fails CORS on every request — which the
# web app can only report as "Could not reach the server".
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Local dev secrets only — production values are set in the Render dashboard.
JWT_ACCESS_SECRET="f9e2c05568741b579f18e4bac7b03714f990eaf54c3db93cf70377ade25330437fc4eeffd3ddd11dac5d80090c2a5335e651e0417604bc1cf8288281c7aa5cfe"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d