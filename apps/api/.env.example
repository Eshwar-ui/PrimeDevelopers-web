# ── How this app is configured ────────────────────────────────────────────
#
# Local development → apps/api/.env (copy this file to it and fill in).
# Production        → the Render dashboard. There is no production file, and
#                     there must not be one: everything below is a secret, and
#                     render.yaml marks each `sync: false` so Render prompts
#                     for the value instead of reading it from the repo.
#
# .env keeps the plain name on purpose. The Prisma CLI reads that file and only
# that file to resolve env("DATABASE_URL") in schema.prisma, so `db:pull`,
# `db:migrate` and `prisma generate` all depend on it. Nest loads
# `.env.$NODE_ENV` first and falls back to `.env` (see src/app.module.ts), so
# an optional apps/api/.env.production lets you run a production-shaped server
# locally — it is gitignored, like everything else here.
#
# Deployed, dotenv is not in play at all: Render's variables are already in
# process.env, and dotenv never overwrites a variable that is set.
#
# The frontend's config is the opposite case and lives in apps/web/.env.example
# — public, committed, and split by mode.
#
# .env is gitignored — never commit real values.


# ── Database (Supabase project knghxhtfkbswzhphhigy) ──────────────────────
# Supabase dashboard → Settings → Database → Connection string.
# DATABASE_URL is the transaction pooler (port 6543) used at runtime.
# DIRECT_URL is the direct connection (port 5432); migrations and
# introspection cannot run through the pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# ── Supabase Storage (server-side uploads, Phase 3) ───────────────────────
# The service-role key bypasses RLS. Server only — never expose it to the
# browser and never give it a VITE_ prefix.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ── Auth ──────────────────────────────────────────────────────────────────
# Only the access token is a JWT. Refresh tokens are opaque random strings
# stored as SHA-256 hashes in the database, so there is no second signing
# secret to manage — the row is the source of truth for validity.
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:5173
# Comma-separated. In production this is the single deployed origin.
#
# Locally it lists Vite's fallback ports as well as 5173: if 5173 is already
# taken Vite quietly starts on the next one, and an origin that is not listed
# here fails CORS on every request — which the web app surfaces only as
# "Could not reach the server", giving no hint that the port is the cause.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
