// Prime Developers website CMS.
//
// This schema is HAND-MAINTAINED, not generated by `prisma db pull`, and that
// is deliberate. The Supabase project is shared with the construction-
// management application, and Prisma 5 has no way to restrict introspection to
// a subset of tables — a `db pull` would drag that application's entire schema
// in here and make this file a liability rather than a description of the CMS.
//
// `pnpm --filter @prime-developers/api db:pull` therefore is NOT the normal
// workflow. To check this file still matches reality, introspect into a scratch
// file and diff the five models below:
//
//   prisma db pull --print > /tmp/live.prisma
//
// Source of truth for the DDL: supabase/migrations/00000000000006_production_cms_setup.sql
// and 00000000000007_grant_anon_access.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — migrations and introspection can't run
  // through the transaction-mode pooler.
  directUrl = env("DIRECT_URL")
}

/// One row per editable site section (hero, about, footer, ...).
/// `data` is an untyped jsonb payload shaped by the admin section editors.
model Content {
  section   String   @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("content")
}

/// A property/development listing. `detail` carries the rich nested content —
/// including buildings and units — as jsonb rather than relational rows.
/// prime-tracker models the same domain relationally; reconciling the two is
/// the actual work of the eventual merge, and is out of scope here.
model Property {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  address   String   @default("")
  category  String   @default("Retail")
  buildings Int      @default(0)
  sold      Int      @default(0)
  available Int      @default(0)
  image     String?
  gallery   Json     @default("[]")
  detail    Json     @default("{}")
  sortOrder Int      @default(0) @map("sort_order")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  leadAttributions WebsiteLeadUnitAttribution[]

  @@map("properties")
}

/// Company news/articles.
///
/// ⚠️ UNRESOLVED: the column names below follow migration 6, which is the DDL
/// that was applied to production. The frontend disagrees — NewsEditPage and
/// NewsPage read and write `excerpt` and `cover_image` (the shape from
/// migrations 2 and 5), never `summary`/`image`. Both cannot be right.
///
/// If production really has `summary`/`image`, then saving a news post is
/// currently broken in production: NewsEditPage spreads the whole form into
/// `.update()`, so Postgres would reject the unknown `excerpt` column.
///
/// Settle this by introspecting the live database before building the news
/// module, and correct whichever side is wrong. Do not guess.
model News {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  title       String
  summary     String    @default("")
  body        String    @default("")
  image       String?
  sortOrder   Int       @default(0) @map("sort_order")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("news")
}

/// Contact-form submissions. Named `website_leads` because `leads` was already
/// taken by the construction-management application on this shared database.
///
/// There is deliberately no unit_label/source_url column here — unit
/// attribution lives in its own table below. ContactPage folds the enquiry's
/// status-at-time-of-asking into the message body, since there is nowhere else
/// to put it.
model WebsiteLead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  unitAttributions WebsiteLeadUnitAttribution[]

  @@map("website_leads")
}

/// Which unit(s) a website lead enquired about.
///
/// The client currently writes this as a second, independent insert after the
/// lead — so a failure here loses the attribution while keeping the lead. The
/// API should write both in one transaction.
model WebsiteLeadUnitAttribution {
  leadId        String   @map("lead_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  unitLabel     String   @map("unit_label")
  buildingLabel String?  @map("building_label")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead     WebsiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([leadId, unitLabel])
  @@map("website_lead_unit_attributions")
}
