// Prime Developers website CMS.
//
// This schema is HAND-MAINTAINED, not generated by `prisma db pull`, and that
// is deliberate. The Supabase project is shared with the construction-
// management application, and Prisma 5 has no way to restrict introspection to
// a subset of tables — a `db pull` would drag that application's entire schema
// in here and make this file a liability rather than a description of the CMS.
//
// `pnpm --filter @prime-developers/api db:pull` therefore is NOT the normal
// workflow. To check this file still matches reality, introspect into a scratch
// file and diff the five models below:
//
//   prisma db pull --print > /tmp/live.prisma
//
// Source of truth for the DDL: supabase/migrations/00000000000006_production_cms_setup.sql
// and 00000000000007_grant_anon_access.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — migrations and introspection can't run
  // through the transaction-mode pooler.
  directUrl = env("DIRECT_URL")
}

/// CMS admin accounts. Replaces Supabase Auth — see
/// supabase/migrations/00000000000008_website_admin_auth.sql for why.
model WebsiteAdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  refreshTokens WebsiteAdminRefreshToken[]

  @@map("website_admin_users")
}

/// Refresh tokens, stored as SHA-256 hashes so a database dump doesn't hand
/// out live sessions. Persisting them is what makes logout revoke rather than
/// merely ask the client to forget.
model WebsiteAdminRefreshToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user WebsiteAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("website_admin_refresh_tokens")
}

/// One row per editable site section (hero, about, footer, ...).
/// `data` is an untyped jsonb payload shaped by the admin section editors.
model Content {
  section   String   @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("content")
}

/// A property/development listing. `detail` carries the rich nested content —
/// including buildings and units — as jsonb rather than relational rows.
/// prime-tracker models the same domain relationally; reconciling the two is
/// the actual work of the eventual merge, and is out of scope here.
model Property {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  address   String   @default("")
  category  String   @default("Retail")
  buildings Int      @default(0)
  sold      Int      @default(0)
  available Int      @default(0)
  image     String?
  gallery   Json     @default("[]")
  detail    Json     @default("{}")
  sortOrder Int      @default(0) @map("sort_order")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  leadAttributions WebsiteLeadUnitAttribution[]

  @@map("properties")
}

/// Company news/articles.
///
/// The columns are `excerpt` and `cover_image`, verified against the live
/// database on 30 Jul 2026. Migration 6 declares them as `summary`/`image`,
/// which is wrong — its `create table if not exists news` was a no-op against
/// the table migration 5 had already renamed into place, so the earlier shape
/// survived. The frontend was right all along.
model News {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String    @default("")
  coverImage  String?   @map("cover_image")
  sortOrder   Int       @default(0) @map("sort_order")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("news")
}

/// Contact-form submissions. Named `website_leads` because `leads` was already
/// taken by the construction-management application on this shared database.
///
/// There is deliberately no unit_label/source_url column here — unit
/// attribution lives in its own table below. ContactPage folds the enquiry's
/// status-at-time-of-asking into the message body, since there is nowhere else
/// to put it.
model WebsiteLead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("new")
  // Which shared-form embed this came through (contact, interiors, franchise,
  // collab, invest) and whatever structured detail that source already knew —
  // an interior option slug, a franchise's desired property, an investment
  // track. Defaults hold for every row written before this column existed.
  source    String   @default("contact")
  context   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  unitAttributions WebsiteLeadUnitAttribution[]

  @@map("website_leads")
}

/// Which unit(s) a website lead enquired about.
///
/// The client currently writes this as a second, independent insert after the
/// lead — so a failure here loses the attribution while keeping the lead. The
/// API should write both in one transaction.
model WebsiteLeadUnitAttribution {
  leadId        String   @map("lead_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  unitLabel     String   @map("unit_label")
  buildingLabel String?  @map("building_label")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead     WebsiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([leadId, unitLabel])
  @@map("website_lead_unit_attributions")
}
