# ── Local development ─────────────────────────────────────────────────────
# Loaded by `vite` (mode: development) — i.e. `pnpm dev`.
#
# Committed on purpose. Nothing here is a secret: it is the origin the browser
# talks to plus the API the dev server proxies to. Personal overrides go in
# .env.development.local (gitignored), never here.

# The browser calls the Vite dev server's own origin; Vite proxies /api to
# DEV_API_TARGET. The dev script pins this port (--strictPort), so the two
# cannot drift apart.
VITE_API_BASE_URL=http://localhost:5173

# Which API a local session hits. Default is the deployed API, so the web app
# works with no database keys — but it is LIVE DATA: admin changes are real.
# To use your own API instead (`pnpm --filter @prime-developers/api dev`), put
#   DEV_API_TARGET=http://localhost:3001
# in apps/web/.env.development.local.
DEV_API_TARGET=https://dtw8rs0oq8bpp.cloudfront.net

# Preconnect hint only; the browser holds no Supabase credentials.
VITE_SUPABASE_URL=https://nrtqntqutquapydsnjbm.supabase.co
