# ── Local development ─────────────────────────────────────────────────────
# Loaded by `vite` (mode: development) — i.e. `pnpm dev`.
#
# Committed on purpose. Nothing here is a secret: it is the origin the browser
# talks to plus one preconnect hint. Keeping it in the repo is the point of the
# split — a fresh clone runs against localhost without anyone hand-editing a
# file, and `vite build` can no longer pick up a developer's local values.
#
# Personal overrides go in .env.development.local (gitignored), never here.

# The browser talks to the Vite dev server's own origin; Vite proxies /api to
# DEV_API_TARGET below, which keeps the deployed API's CORS allowlist — which
# knows nothing about localhost — out of the way.
VITE_API_BASE_URL=http://localhost:3001

# Which API a local session actually hits. Point at the local Nest server
# (`pnpm --filter @prime-developers/api dev`), or swap in the deployed one to
# work against real data without running the API:
#   DEV_API_TARGET=https://prime-developers-api.onrender.com
DEV_API_TARGET=http://localhost:3001

# Used only for the <link rel="preconnect"> in index.html — image and .glb URLs
# are public bucket links. The browser holds no Supabase credentials; all data
# goes through the API.
VITE_SUPABASE_URL=https://knghxhtfkbswzhphhigy.supabase.co
