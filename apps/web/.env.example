# Prime Developers API (apps/api). In production this is the Render service URL.
VITE_API_BASE_URL=http://localhost:3001

# Supabase — still used for Storage (image and .glb URLs, admin uploads) and,
# until the admin cutover lands, for the admin CMS reads and writes.
# Run `supabase status` after `supabase start` to get these.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
