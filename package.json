{
  "name": "prime-developers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @prime-developers/web build",
    "deploy:web": "pnpm run build:web && firebase deploy --only hosting",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "seed": "node --env-file=.env.seed scripts/seed.js",
    "seed:interiors-demo": "node --env-file=apps/api/.env scripts/seed-interiors-demo.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
