{
  "name": "prime-developers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @prime-developers/web build",
    "deploy:web": "bash scripts/deploy-web-aws.sh",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db && pnpm --filter @prime-developers/api exec prisma migrate deploy",
    "db:down": "docker compose stop db",
    "db:seed": "bash scripts/db-seed-from-prod.sh",
    "monitors": "node scripts/uptimerobot.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
